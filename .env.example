# Add the real GA4 Web data stream ID before production deployment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Canonical production origin after the .id.vn domain is known.
SITE_URL=https://thanhtuyennt1405.id.vn

# Supabase Project URL and public key. Legacy anon or newer publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only: legacy service role or newer secret key. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-secret-key
IP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CRON_SECRET=replace-with-another-random-secret
